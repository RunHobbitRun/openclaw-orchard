[Unit]
Description=OpenClaw Orchard Watchdog
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=orchard
WorkingDirectory=/opt/orchard/openclaw
EnvironmentFile=/opt/orchard/openclaw/.env
ExecStart=/opt/orchard/openclaw/watchdog.sh
Restart=always
RestartSec=10
StandardOutput=append:/var/log/orchard/watchdog.log
StandardError=append:/var/log/orchard/watchdog.log

[Install]
WantedBy=multi-user.target
