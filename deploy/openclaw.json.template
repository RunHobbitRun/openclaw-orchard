{
  // OpenClaw Orchard — Server Configuration
  // Copy to ~/.openclaw/openclaw.json on the server and fill in values.
  // API keys should be in .env, NOT here.

  "agent": {
    "model": "gemini/gemini-3.1-pro-preview"
  },

  "channels": {
    "telegram": {
      // Bot token is read from TELEGRAM_BOT_TOKEN env var
      // Set separate session routing per bot if needed
    }
  },

  "gateway": {
    "auth": {
      // Token is read from OPENCLAW_GATEWAY_TOKEN env var
    },
    "bind": "lan",
    "port": 18789
  },

  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "sandbox": {
        "mode": "non-main"
      }
    },
    "routing": [
      {
        "id": "manager",
        "name": "Manager",
        "workspace": "~/.openclaw/workspace/manager",
        "model": "gemini/gemini-3.1-pro-preview"
      },
      {
        "id": "auditor",
        "name": "Auditor",
        "workspace": "~/.openclaw/workspace/auditor",
        "model": "gemini/gemini-3-flash"
      },
      {
        "id": "finance",
        "name": "Finance",
        "workspace": "~/.openclaw/workspace/finance",
        "model": "gemini/gemini-3-flash"
      },
      {
        "id": "intelligence",
        "name": "Intelligence",
        "workspace": "~/.openclaw/workspace/intelligence",
        "model": "gemini/gemini-3-flash"
      },
      {
        "id": "security",
        "name": "Security",
        "workspace": "~/.openclaw/workspace/security",
        "model": "gemini/gemini-3-flash"
      },
      {
        "id": "scout",
        "name": "Scout",
        "workspace": "~/.openclaw/workspace/scout",
        "model": "gemini/gemini-3.1-pro-preview"
      },
      {
        "id": "devteam",
        "name": "DevTeam",
        "workspace": "~/.openclaw/workspace/devteam",
        "model": "anthropic/claude-sonnet-4-6"
      },
      {
        "id": "factory",
        "name": "Factory",
        "workspace": "~/.openclaw/workspace/factory",
        "model": "gemini/gemini-3.1-pro-preview"
      },
      {
        "id": "sniper",
        "name": "Sniper",
        "workspace": "~/.openclaw/workspace/sniper",
        "model": "gemini/gemini-3.1-pro-preview"
      },
      {
        "id": "trader_farmer",
        "name": "TraderFarmer",
        "workspace": "~/.openclaw/workspace/trader_farmer",
        "model": "gemini/gemini-3-flash"
      },
      {
        "id": "trader_quant",
        "name": "TraderQuant",
        "workspace": "~/.openclaw/workspace/trader_quant",
        "model": "gemini/gemini-3.1-pro-preview"
      },
      {
        "id": "prediction_god",
        "name": "PredictionGod",
        "workspace": "~/.openclaw/workspace/prediction_god",
        "model": "gemini/gemini-3.1-pro-preview"
      }
    ]
  },

  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "provider": "perplexity"
      }
    }
  },

  "security": {
    "promptInjectionGuard": true,
    "sanitizeExternalContent": true
  }
}
